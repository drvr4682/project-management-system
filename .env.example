#Postgres Container
POSTGRES_USER=your_postgres_container_username
POSTGRES_PASSWORD=your_postgres_container_password

# Database
AUTH_DB_URL=your_auth_db_url
PROJECT_DB_URL=your_project_db_url
TASK_DB_URL=your_task_db_url

POSTGRES_PORT=your_postgres_port_no.

AUTH_DB_USERNAME=your_auth_db_username
AUTH_DB_PASSWORD=your_auth_db_password

PROJECT_DB_USERNAME=your_project_db_username
PROJECT_DB_PASSWORD=your_project_db_password

TASK_DB_USERNAME=your_task_db_username
TASK_DB_PASSWORD=your_task_db_password

#Database Names
AUTH_DB_NAME=your_auth_db_name
PROJECT_DB_NAME=your_project_db_name
TASK_DB_NAME=your_task_db_name

# JWT
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRATION=your_JWT_expiration_time
JWT_REFRESH_EXPIRATION=your_jwt_refresh_expration_time

# Internal Gateway Security
GATEWAY_SECRET=your_gateway_secret

# Internal security
INTERNAL_SECRET=your_internal_secret

# INTERNAL SERVICE URLS
AUTH_SERVICE_URL=your_auth_service_url
PROJECT_SERVICE_URL=your_project_service_url
TASK_SERVICE_URL=your_task_service_url

# SERVICE PORTS
API_GATEWAY_PORT=your_api_gateway_port_no.
AUTH_SERVICE_PORT=your_auth_service_port_no.
PROJECT_SERVICE_PORT=your_project_service_port_no.
TASK_SERVICE_PORT=your_task_service_port_no.

# Redis (JWT blocklist for logout invalidation)
#======================================================
REDIS_HOST=your_redis_host_name
REDIS_PORT=your_redis_port_no.
REDIS_PASSWORD=

# =====================================================
# MAIL  (Gmail SMTP)
#
# IMPORTANT: Use a Gmail App Password, NOT your real Gmail password.
# =====================================================
MAIL_HOST=your_mail_id_host
MAIL_PORT=your_mail_id_port_no.
MAIL_USERNAME=your_mail_id
MAIL_PASSWORD=your_16_char_gmail_app_password_here

# =====================================================
# EMAIL VERIFICATION
# =====================================================
# How long the verification link stays valid (default 24 hours = 1440 minutes)
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440

# How long the password-reset link stays valid (default 15 minutes)
PASSWORD_RESET_EXPIRY_MINUTES=15

# Base URL used to build links in emails.
APP_BASE_URL=your_app_base_url