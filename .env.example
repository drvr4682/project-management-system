# =====================================================
# PostgreSQL Container Configuration
# =====================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# =====================================================
# Database URLs and Credentials
# =====================================================
# Note: In Docker, use service name "postgres" as hostname
# Format: jdbc:postgresql://HOST:PORT/DATABASE_NAME

AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_secure_password

PROJECT_DB_URL=jdbc:postgresql://postgres:5432/project_db
PROJECT_DB_NAME=project_db
PROJECT_DB_USERNAME=project_user
PROJECT_DB_PASSWORD=project_secure_password

TASK_DB_URL=jdbc:postgresql://postgres:5432/task_db
TASK_DB_NAME=task_db
TASK_DB_USERNAME=task_user
TASK_DB_PASSWORD=task_secure_password

# =====================================================
# JWT Configuration
# =====================================================
# Must be 32+ characters
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# =====================================================
# Internal Service Security
# =====================================================
# Used for gateway-to-service and service-to-service communication
GATEWAY_SECRET=your_gateway_secret_32_characters_minimum
INTERNAL_SECRET=your_internal_secret_32_characters_minimum

# =====================================================
# Service URLs (internal Docker network)
# =====================================================
AUTH_SERVICE_URL=http://authservice:8081
PROJECT_SERVICE_URL=http://projectservice:8082
TASK_SERVICE_URL=http://taskservice:8083

# =====================================================
# Service Ports
# =====================================================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PROJECT_SERVICE_PORT=8082
TASK_SERVICE_PORT=8083

# =====================================================
# Redis Configuration
# =====================================================
# In Docker: host is service name "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_32_chars_minimum

# =====================================================
# Email Configuration (Gmail SMTP)
# =====================================================
# IMPORTANT: Use Gmail App Password, NOT your real Gmail password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply.pms.app@gmail.com
MAIL_PASSWORD=your-google-app-password

# =====================================================
# Email Token Expiration
# =====================================================
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440
PASSWORD_RESET_EXPIRY_MINUTES=15

# =====================================================
# Application URLs
# =====================================================
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000