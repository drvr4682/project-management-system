# Database
AUTH_DB_URL=your_auth_db_url
PROJECT_DB_URL=your_auth_db_url
TASK_DB_URL=your_auth_db_url

DB_USERNAME=your_DB_username
DB_PASSWORD=your_DB_password


# JWT
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRATION=your_JWT_expiration_time

# Internal Gateway Security
GATEWAY_SECRET=your_gateway_secret

# Internal security
INTERNAL_SECRET=your_internal_secret

# INTERNAL SERVICE URLS
AUTH_SERVICE_URL=http://localhost:8081
PROJECT_SERVICE_URL=http://localhost:8082
TASK_SERVICE_URL=http://localhost:8083

# SERVICE PORTS
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PROJECT_SERVICE_PORT=8082
TASK_SERVICE_PORT=8083