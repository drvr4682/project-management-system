{
	"info": {
		"_postman_id": "0d6ee942-fa30-4e38-9580-be3e7c80eb7c",
		"name": "Email Verification & Password Reset API",
		"description": "Production-hardened Postman collection for validating user registration, email verification endpoints, blocked login behavior, token reuse/expiration rejection, resend cooldown protections, forgot password flows, anti-enumeration security, and password resets.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"USER\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				},
				"description": "Registers a new user. The account is created with enabled=false and emailVerified=false. A verification UUID token is persisted in the database, and a plain text verification email is sent to the user's inbox."
			},
			"response": []
		},
		{
			"name": "2. Login (Blocked - Unverified)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Attempts to log in before verifying the email. This should be blocked by Spring Security / Authentication Manager, returning a 401 Unauthorized response."
			},
			"response": []
		},
		{
			"name": "3. Verify Email",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/verify?token=YOUR_UUID_TOKEN_HERE",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"verify"
					],
					"query": [
						{
							"key": "token",
							"value": "YOUR_UUID_TOKEN_HERE",
							"description": "The unique verification token received in the verification email."
						}
					]
				},
				"description": "Submits the verification token. If valid, the user is enabled (enabled=true, emailVerified=true) and the token is updated to used=true in the database. Subsequent validation attempts on this same token will be rejected."
			},
			"response": []
		},
		{
			"name": "4. Login (Success - Verified)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Logs in after successful email verification. The authentication manager credentials check succeeds, and standard JWT Access and Refresh tokens are successfully returned."
			},
			"response": []
		},
		{
			"name": "5. Resend Verification Link",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane.doe@example.com\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/resend-verification",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"resend-verification"
					]
				},
				"description": "Requests a new verification email for an unverified account. This will invalidate any previously generated unused tokens (setting used=true), create a new UUID token, send a new email, and enforce a 60-second cooldown protection on subsequent requests."
			},
			"response": []
		},
		{
			"name": "6. Forgot Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane.doe@example.com\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				},
				"description": "Requests a password reset link. Anti-enumeration security: Always returns 200 OK with message: 'If the account exists, a password reset link has been sent.', regardless of whether the email exists or cooldown is active. Enforces a 60-second cooldown per email."
			},
			"response": []
		},
		{
			"name": "7. Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"YOUR_RESET_TOKEN_HERE\",\n  \"newPassword\": \"NewSecurePass123!\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/reset-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"reset-password"
					]
				},
				"description": "Submits the password reset token and new password. Performs validation, hashes the new password, updates the user account, invalidates the token (setting used=true), and revokes all older refresh tokens to force active sessions to re-authenticate."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}
